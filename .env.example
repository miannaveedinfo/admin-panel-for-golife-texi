# ==============================================================================
# GoLife Taxi Pakistan — Production Deployment & Environment Configuration Guide
# ==============================================================================
#
# THREE-STAGE DEPLOYMENT PIPELINE:
# ------------------------------------------------------------------------------
# 1. DEMO / DEVELOPMENT (Default Testing Sandbox):
#    VITE_DATA_SOURCE=DEMO
#    VITE_DEPLOYMENT_STAGE=TESTING
#    - 100% self-contained sandbox.
#    - Zero external cloud credentials or secrets required.
#    - Safe simulated fleet datasets with local reactivity.
#    - Impossible to write to production or trigger real payments/payouts.
#
# 2. STAGING / PRE-PRODUCTION (Verification & Pre-Launch Testing):
#    VITE_DATA_SOURCE=PRODUCTION
#    VITE_DEPLOYMENT_STAGE=PRE_PRODUCTION
#    - Connects to staging Firebase project and sandbox payment accounts.
#    - Full end-to-end integration testing before live launch.
#    - Production safety locks active; no demo fallback allowed.
#
# 3. LIVE PRODUCTION:
#    VITE_DATA_SOURCE=PRODUCTION
#    VITE_DEPLOYMENT_STAGE=LIVE
#    - Connects to official GoLife production Firebase cluster.
#    - Live Firestore, Firebase Auth, and Storage.
#    - Live Easypaisa, JazzCash, and Raast payment settlement accounts.
#    - Demo data is strictly blocked; missing config halts affected components.
#
# ==============================================================================
# SECTION 1: CORE DEPLOYMENT SWITCHES
# ==============================================================================

# Central Mode Switch ('DEMO' | 'PRODUCTION')
VITE_DATA_SOURCE=DEMO

# Deployment Stage ('TESTING' | 'PRE_PRODUCTION' | 'LIVE')
VITE_DEPLOYMENT_STAGE=TESTING

# Production Domain & HTTPS URL:
VITE_APP_URL=https://admin.golifetaxi.com

# ==============================================================================
# SECTION 2: FIREBASE CLOUD INFRASTRUCTURE (Required when VITE_DATA_SOURCE=PRODUCTION)
# Obtain from Firebase Console -> Project Settings -> General -> Your Apps (Web)
# ==============================================================================
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================================================================
# SECTION 3: PAKISTAN NATIONAL PAYMENT RAILS CONFIGURATION
# (Never store private API secrets or service accounts in client environment)
# ==============================================================================
# Payment Environment: 'sandbox' or 'live'
VITE_PAYMENT_ENVIRONMENT=sandbox

# Easypaisa Corporate Merchant Gateway:
VITE_EASYPAISA_STORE_ID=your-easypaisa-store-id
VITE_EASYPAISA_MERCHANT_NAME=GoLife Taxi Pakistan (Pvt) Ltd

# JazzCash Corporate Merchant Gateway:
VITE_JAZZCASH_MERCHANT_ID=your-jazzcash-merchant-id
VITE_JAZZCASH_STORE_ID=your-jazzcash-store-id

# Raast Instant Payment Participant ID (State Bank of Pakistan):
VITE_RAAST_PARTICIPANT_ID=PK-SBP-RAAST-GOLIFE-01

# ==============================================================================
# SECTION 4: GEO-SERVICES & GOOGLE MAPS PLATFORM
# ==============================================================================
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ==============================================================================
# SECTION 5: PUSH NOTIFICATION SERVICES (Driver & Passenger Mobile App Dispatch)
# ==============================================================================
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id
VITE_FCM_VAPID_KEY=your-fcm-vapid-key
