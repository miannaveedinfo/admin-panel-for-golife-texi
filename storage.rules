rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny all unknown storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Driver KYC and verification documents:
    // Only the driver or authorized admins can read; only the driver can upload their documents
    match /drivers/{driverId}/kyc/{docName} {
      allow read: if isSignedIn();
      allow write: if isOwner(driverId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Vehicle documents (registration, insurance, fitness):
    match /vehicles/{vehicleId}/{docName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    // User profile avatars (passenger and driver avatars):
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Dispute & Support ticket attachments:
    match /support/{caseId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Safety incident evidence (SOS audio, crash photos):
    match /safety/{incidentId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.resource.size < 25 * 1024 * 1024;
    }
  }
}
